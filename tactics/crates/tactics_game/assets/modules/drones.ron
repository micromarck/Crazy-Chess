// Example module: a custom glTF MODEL with ANIMATIONS, plus a CAMERA SCRIPT.
//
// The drone model (assets/models/drone.gltf) was generated by
// tools/gen_drone_gltf.py. Swap `scene` / `clip` paths for your own models;
// paths are relative to the game's `assets/` folder and use glTF labels
// (`#Scene0`, `#Animation2`...).
(
    info: (
        id: "drones",
        name: "Drone Pack",
        version: "1.0",
        description: "Adds an animated glTF drone enemy and a laser with its own camera move.",
    ),

    models: [
        (
            id: "drone",
            scene: "models/drone.gltf#Scene0",
            fallback: Drone,            // shown while loading / if the file is missing
            scale: 1.0,
            offset: (0.0, 0.0, 0.0),
            yaw_degrees: 0.0,           // the model already faces -Z
            animations: {
                // slot:  (clip, speed, looping)
                "idle":  (clip: "models/drone.gltf#Animation0", looping: true),
                "walk":  (clip: "models/drone.gltf#Animation1", looping: true),
                "shoot": (clip: "models/drone.gltf#Animation2"),
                "hit":   (clip: "models/drone.gltf#Animation3"),
                "death": (clip: "models/drone.gltf#Animation4"),
                // No "overwatch"/"hunker"/"reload" clips: the game falls back
                // to procedural animations for those slots.
            },
        ),
    ],

    weapons: [
        (
            id: "drone_laser",
            name: "Drone Laser",
            damage_min: 2,
            damage_max: 4,
            crit_chance: 10,
            optimal_range: 8.0,
            max_range: 16.0,
            clip_size: 4,
        ),
    ],

    abilities: [
        (
            id: "laser",
            name: "Laser",
            description: "Precise beam: fixed 70% base accuracy.",
            ammo_cost: 1,
            targeting: Enemy,
            effect: Attack(base_accuracy: 70, half_cover_penalty: 20, full_cover_penalty: 35),
        ),
    ],

    classes: [
        (
            id: "drone",
            name: "Drone",
            stats: (max_hp: 5, mobility: 14, aim: 60, defense: 10, sight: 15.0),
            weapon: "drone_laser",
            abilities: ["laser", "overwatch", "reload"],
            model: "drone",
        ),
    ],

    // A camera script: dolly in on the drone, swing around to look down the
    // beam, hold, then hand the camera back.
    camera_scripts: [
        (
            id: "laser_cam",
            steps: [
                Together([
                    Focus(on: Actor, duration: 0.3),
                    Zoom(distance: 7.0, duration: 0.3),
                ]),
                Together([
                    Focus(on: Midpoint, duration: 0.5),
                    FaceAlong(from: Actor, to: Target, offset_degrees: -30.0, duration: 0.5),
                    Pitch(degrees: 20.0, duration: 0.5),
                ]),
                Wait(duration: 0.8),
                Restore(duration: 0.5),
            ],
        ),
    ],

    presentations: [
        (ability: "laser", animation: "shoot", camera: "laser_cam", camera_chance: 60, projectile: Beam, windup: 0.25),
    ],

    // Put two drones into the alien squad.
    squads: [
        (
            id: "enemy",
            members: [
                (class: "sectoid", name: "Sectoid 1"),
                (class: "drone", name: "Drone A"),
                (class: "sectoid", name: "Sectoid 2"),
                (class: "drone", name: "Drone B"),
                (class: "sectoid", name: "Sectoid 3"),
            ],
        ),
    ],
)
