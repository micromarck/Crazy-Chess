<?xml version="1.0" encoding="utf-8"?>
<!--
  Scrapyard: corrupted robots (Corrupted Robots module) in a junkyard. They
  shed armour and malfunction more every turn, so time is on your side:
  destroy them, or hold out until they grind to a halt.

  Coordinates: x = column from the left, y = ROW FROM THE TOP of <layout>.
-->
<mission id="scrapyard" name="Scrapyard" seed="5150" fog="true">
  <description>Corrupted machines roam a junkyard. They break down a little more every turn: destroy them, or survive 8 turns until they grind to a halt.</description>

  <layout>
    ..............................
    ..............................
    ..........H...................
    ...HHHH...H.........HHHHH.....
    ...HHHH...H...................
