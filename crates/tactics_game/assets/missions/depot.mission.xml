<?xml version="1.0" encoding="utf-8"?>
<!--
  Supply Depot: the demo map as a mission.

  Coordinates: x = column from the left, y = ROW FROM THE TOP of <layout>.
  Layout: . floor   # cut out   h half cover   H full cover
-->
<mission id="depot" name="Supply Depot" seed="24301">
  <description>Clear the depot. The leader holds the raised loading dock; mind the fuel barrels.</description>

  <layout>
    ......................
    ..HH....h.....hh......
    ..HH....h.............
    ..........HHH.........
    .hh.......H.....HH....
    ..........H.....HH..h.
    ....h...............h.
    ....h....##...........
    .........##.....h.....
    ..HHH...........h.....
    ......h....HH.........
    ......h....HH.....hh..
    ......................
    ........hhh.....H.....
    ................H.....
    ......................
  </layout>

  <!-- Ground level per tile (same shape). The loading dock (1) can be stepped
       onto; the watchtower (3) needs its ladder. -->
  <heights>
    0000000000000000111111
    0000000000000000111111
    0000000000000000111111
    0000000000000000000000
    0000000000000000000000
    0000000000000000000000
    3300000000000000000000
    3300000000000000000000
    0000000000000000000000
    0000000000000000000000
    0000000000000000000000
    0000000000000000000000
    0000000000000000000000
    0000000000000000000000
    0000000000000000000000
    0000000000000000000000
  </heights>
  <ladder x="2" y="7"/>

  <!-- The player's squad (from the loaded modules), placed around this tile. -->
  <deploy team="player" squad="player" x="2" y="13"/>

  <unit team="enemy" class="sectoid" name="Sectoid Leader" x="19" y="1" tag="leader">
    <script on="spotted" once="true">message("Contact: the Sectoid leader is on the loading dock.");</script>
    <script on="death">message("The leader is down!");</script>
  </unit>
  <unit team="enemy" class="sectoid" name="Sectoid 1" x="18" y="2"/>
  <unit team="enemy" class="drone" name="Drone A" x="20" y="0"/>
  <unit team="enemy" class="sectoid" name="Sectoid 2" x="12" y="5"/>

  <!-- Props: cover you can destroy. Barrels explode when destroyed. -->
  <prop tag="barrel_dock" kind="barrel" x="18" y="1" cover="half" hp="2">
    <script on="destroyed">message("The fuel barrel explodes!"); explode(x, y, 1.6, 4);</script>
  </prop>
  <prop tag="barrel_yard" kind="barrel" x="15" y="4" cover="half" hp="2">
    <script on="destroyed">explode(x, y, 1.6, 4);</script>
  </prop>
  <prop tag="crate_1" kind="crate" x="6" y="12" cover="half" hp="4"/>
  <prop tag="terminal" kind="console" x="5" y="2" cover="half"/>

  <!-- A tile script: whoever of the squad reaches the terminal gets intel. -->
  <tile x="5" y="3">
    <script on="enter" team="player" once="true">
      message("Intel downloaded: alien reinforcements inbound on round 3.");
      set_flag("intel", 1);
      give_ap(unit, 1);
    </script>
  </tile>

  <script on="start">message("Clear the depot. Fuel barrels explode when shot.");</script>

  <script on="turn_start" team="enemy">
    if round == 3 {
      spawn_unit("enemy", "drone", "Drone B", 21, 0);
      if flag("intel") == 1 { message("As predicted: a drone arrives at the dock."); }
      else { message("Enemy reinforcements!"); }
    }
  </script>
</mission>
