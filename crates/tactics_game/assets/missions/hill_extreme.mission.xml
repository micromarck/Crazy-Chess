  <script>
    // Keeps 25-30 zombies on the hill; more gather at the shore, up to 75.
    fn horde_tide() {
      let alive = alive_count("enemy");
      let on_hill = count_in_area(14, 14, 37, 37, "enemy");
      let want = rand(25, 30);
      let n = want - on_hill;
      // The shore keeps filling up even when the hill is full.
      if n < 5 { n = 5; }
      if n > 75 - alive { n = 75 - alive; }
      if n > 15 { n = 15; }
      let pts = [[61, 32], [61, 28], [60, 24], [59, 20], [57, 16], [54, 13], [52, 10], [48, 8], [45, 6], [41, 4], [37, 3], [33, 3], [29, 3], [25, 4], [21, 5], [17, 7], [14, 9], [11, 12], [8, 15], [6, 18], [4, 22], [3, 26], [3, 30], [3, 34], [3, 38], [4, 42], [6, 46], [8, 49], [11, 52], [14, 55], [17, 57], [21, 59], [25, 60], [29, 61], [33, 61], [37, 61], [41, 60], [45, 58], [48, 56], [52, 54], [54, 51], [57, 48], [59, 44], [60, 40], [61, 36]];
      for i in 0..n {
        let p = pts[rand(0, pts.len() - 1)];
        spawn_unit("enemy", "zombie", "Shambler", p[0], p[1]);
      }
      if n > 0 && on_hill < 25 { message("More of them are crawling out of the treeline..."); }
    }
  </script>
  <script on="start">
    set_flag("evac", 0);
    message("Hold the hilltop. The chopper is 12 turns out.");
    message("They can't climb the cliffs to the north and east - watch the south and west slopes.");
    objective("Survive until the evac chopper arrives (turn 12)");
  </script>
  <script on="turn_start" team="enemy">horde_tide();
  </script>
  <script on="turn_start" team="player">
    let left = 12 - round;
    if left > 0 {
      objective("Survive until the evac chopper arrives: " + left + (if left == 1 { " turn" } else { " turns" }));
      if left <= 3 { message("Evac in " + left + (if left == 1 { " turn!" } else { " turns!" })); }
    } else {
      if flag("evac") == 0 {
        set_flag("evac", 1);
        message("The chopper is down on the pad! Everyone aboard!");
        zone_label("evac", "EVAC - BOARD NOW");
        objective("Get everyone still alive onto the evac pad");
      }
      let squad = alive_count("player");
      if squad > 0 && zone_count("evac", "player") >= squad {
        message("Everyone's aboard - the chopper lifts off the hill. Mission complete!");
        win();
      }
    }
  </script>
