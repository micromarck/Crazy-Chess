    <script on="enter" team="player">
      if flag("relays_done") == 1 {
        let squad = alive_count("player");
        let here = zone_count("stairs", "player");
        if squad > 0 && here >= squad { message("Down the stairwell, away from what's left of VESPER's mind."); win(); }
        else { message(here + " of " + squad + " here - everyone still alive has to make it."); }
      } else { message("VESPER can still follow you from its relays - destroy all three first."); }
    </script>
  </zone>

  <script on="start">
    set_flag("relays", 0); set_flag("relays_done", 0);
    message("The server catacombs: VESPER thinks down here. Three relay nodes carry it deeper.");
    objective("Destroy the three relay nodes (0 of 3)");
  </script>
  <script on="unit_killed">
    if unit_class(unit) == "vesper_relay" {
      set_flag("relays", flag("relays") + 1);
      if flag("relays") >= 3 {
        set_flag("relays_done", 1);
        message("The last relay dies. VESPER's voice cracks: 'You're... making me... smaller.'");
        objective("Get the whole squad to the stairwell (south-east)");
      } else {
        objective("Destroy the three relay nodes (" + flag("relays") + " of 3)");
      }
    }
  </script>
  <script on="turn_start" team="player">
    let squad = alive_count("player");
    if flag("relays_done") == 1 && squad > 0 && zone_count("stairs", "player") >= squad {
      message("Down the stairwell, away from what's left of VESPER's mind.");
      win();
    }
  </script>
