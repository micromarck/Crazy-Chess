<!--
  Mission index: lists the mission files in this folder (the web build can't
  list folders, so they're named here). `start` is the mission that begins
  when the game launches. See MISSIONS.md for the mission file format.
-->
<missions start="depot">
  <mission file="training.mission.xml"/>
  <mission file="depot.mission.xml"/>
  <mission file="rooftops.mission.xml"/>
  <mission file="proving_grounds.mission.xml"/>
  <mission file="holdout.mission.xml"/>
  <mission file="complex.mission.xml"/>
  <mission file="infiltration.mission.xml"/>
  <mission file="lab.mission.xml"/>
</missions>
