<?xml version="1.0" encoding="utf-8"?>
<!--
  Salvage Run: a merc crew (Mercenaries module) is hauling corrupted robots
  (Corrupted Robots module) out of a warehouse. Grab the robot core they're
  after and get back to the evac point.

  Coordinates: x = column from the left, y = ROW FROM THE TOP of <layout>.
-->
<mission id="salvage_run" name="Salvage Run" seed="9024" fog="true" win="script">
  <description>A merc salvage crew is hauling corrupted robots out of a warehouse. Steal the robot core from inside and bring it back to the evac point.</description>

