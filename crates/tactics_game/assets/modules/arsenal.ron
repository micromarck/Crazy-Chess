// Arsenal: laser and heavy weapons for the human squad, plus the Heavy
// Gunner class that carries the big ones. Pick them per soldier in the
// Loadout screen (each weapon's `classes` says who can carry it).
//
// Lasers: almost no spread, fewer but sharper hits, beams instead of tracers.
//   Laser Rifle (anyone), Laser Lance (snipers), Scatter Laser (assault).
// Heavy: Minigun (heavy gunners), Autocannon (heavy gunners, grenadiers) and
//   the Rocket Launcher item (a straight-flying rocket that goes off at the
//   first thing in its way; heavy gunners, grenadiers).
// Particle Grenade (anyone): a short throw that arms where it lands and goes
//   off two turns later: 5 damage in a 5x5 square plus shrapnel.
// Mobility: the Jump Pack item (a straight-line leap over walls, any soldier).
// Fire: the Flamethrower main weapon (heavy gunners, assault: Shoot sweeps
//   a cone of fire), the Flamethrower item (a cone of flame that leaves the ground
//   burning; heavy gunners, assault) and Incendiary Grenades (anyone).
(
    info: (
        id: "arsenal",
        name: "Arsenal",
        version: "1.0",
        author: "Tactics",
        description: "Laser rifles, a laser lance and scatter laser; the minigun, autocannon and rocket launcher; and the Heavy Gunner class.",
    ),

    weapons: [
        // --- Lasers ---
        (
            id: "laser_rifle",
            name: "Laser Rifle",
            damage_min: 1,
            damage_max: 2,
            crit_chance: 10,
            crit_bonus: 1,
            optimal_range: 8.0,
            max_range: 16.0,
            burst: 3,
            spread: 0.3,
            clip_size: 18,
            magazines: 3,
            look: Laser,
        ),
        (
            id: "laser_lance",
            name: "Laser Lance",
            classes: ["sniper"],
            damage_min: 5,
            damage_max: 7,
            crit_chance: 20,
            crit_bonus: 2,
            optimal_range: 14.0,
            max_range: 26.0,
            burst: 1,
            spread: 0.05,
            min_range: 5.0,
            close_penalty: 8,
            clip_size: 4,
            magazines: 3,
            look: Laser,
        ),
        (
            id: "scatter_laser",
            name: "Scatter Laser",
            classes: ["assault"],
            damage_min: 1,
            damage_max: 2,
            crit_chance: 10,
            optimal_range: 3.0,
            max_range: 9.0,
            burst: 1,
            pellets: 6,
            spread: 2.2,
            ignores_cover: true,
            clip_size: 6,
            magazines: 3,
            look: Laser,
        ),
        // --- Heavy weapons ---
        (
            id: "minigun",
            name: "Minigun",
            classes: ["heavy"],
            damage_min: 1,
            damage_max: 1,
            crit_chance: 5,
            crit_bonus: 1,
            optimal_range: 6.0,
            max_range: 13.0,
            burst: 12,
            spread: 2.2,
            clip_size: 120,
            magazines: 1,
            look: Minigun,
        ),
        (
            // A main weapon: Shoot hoses a 45-degree cone of fire out to the
            // target (5 tiles at most). Never misses, ignores cover, burns
            // everyone in the cone (friend or foe) and leaves it alight for
            // 2 rounds. Each burst is one charge of fuel. Can't suppress.
            id: "flamer",
            name: "Flamethrower",
            classes: ["heavy", "assault"],
            damage_min: 2,
            damage_max: 3,
            crit_chance: 0,
            optimal_range: 3.0,
            max_range: 5.0,
            clip_size: 4,
            magazines: 2,
            cone: 45.0,
            ignite: 2,
            look: Flamer,
        ),
        (
            id: "autocannon",
            name: "Autocannon",
            classes: ["heavy", "grenadier"],
            damage_min: 3,
            damage_max: 4,
            crit_chance: 10,
            crit_bonus: 2,
            optimal_range: 9.0,
            max_range: 18.0,
            burst: 2,
            spread: 0.9,
            clip_size: 8,
            magazines: 3,
            look: Lmg,
        ),
    ],

    abilities: [
        (
            id: "fire_rocket",
            name: "Fire Rocket",
            description: "Fire a rocket at a tile: it flies straight and goes off at the first wall or unit in its way. 4-6 damage to everyone within 2 tiles, wrecks walls and props, 14 fragments fly further. One rocket per launcher.",
            cost: EndsTurn,
            charges: Some(1),
            targeting: Tile,
            range: Fixed(15.0),
            requires_los: true,
            effect: Attack(
                can_miss: false,
                half_cover_penalty: 0,
                full_cover_penalty: 0,
                range_falloff: false,
                flank_crit_bonus: 0,
                damage: Fixed(min: 4, max: 6),
                area_radius: 2.0,
                shrapnel: 14,
                direct: true,
            ),
        ),
        (
            id: "flamethrower",
            name: "Flamethrower",
            description: "Hose a 50-degree cone out to 5 tiles: 2-3 damage to everyone in it you can see (friend or foe), ignoring cover, and sets it ablaze for 2 rounds. 2 tanks.",
            cost: EndsTurn,
            charges: Some(2),
            targeting: Tile,
            range: Fixed(5.0),
            requires_los: true,
            effect: Attack(
                can_miss: false,
                half_cover_penalty: 0,
                full_cover_penalty: 0,
                range_falloff: false,
                flank_crit_bonus: 0,
                damage: Fixed(min: 2, max: 3),
                cone: 50.0,
                ignite: 2,
            ),
        ),
        (
            id: "jump",
            name: "Jump",
            description: "Jump pack: leap in a straight line up to 2 times your normal move, over walls, gaps and heads. 1 AP, 2 turn cooldown.",
            cost: Points(1),
            cooldown: 2,
            targeting: Tile,
            range: Fixed(0.0),
            requires_los: false,
            effect: Leap(reach: 2.0, over_walls: true),
        ),
        (
            id: "particle_grenade",
            name: "Particle Grenade",
            description: "Lob it a short way (5 tiles). It arms where it lands and goes off at the start of your second turn after: 5 damage to everyone in a 5x5 square (2 tiles out on every side), wrecks walls and props, and 20 fragments fly further. Never misses. Ends the turn.",
            cost: EndsTurn,
            charges: Some(1),
            targeting: Tile,
            range: Fixed(5.0),
            requires_los: true,
            effect: Attack(
                can_miss: false,
                half_cover_penalty: 0,
                full_cover_penalty: 0,
                range_falloff: false,
                flank_crit_bonus: 0,
                damage: Fixed(min: 5, max: 5),
                area_radius: 2.0,
                square: true,
                fuse: 2,
                shrapnel: 20,
            ),
        ),
        (
            id: "incendiary_grenade",
            name: "Incendiary Grenade",
            description: "Throw at a tile: 1-2 damage within 1.5 tiles and the area burns for 3 rounds (2 damage to anyone starting a turn in it, 1 per burning tile walked through).",
            cost: Points(1),
            charges: Some(1),
            targeting: Tile,
            range: Fixed(10.0),
            requires_los: true,
            effect: Attack(
                can_miss: false,
                half_cover_penalty: 0,
                full_cover_penalty: 0,
                range_falloff: false,
                flank_crit_bonus: 0,
                damage: Fixed(min: 1, max: 2),
                area_radius: 1.5,
                ignite: 3,
            ),
        ),
    ],

    presentations: [
        (ability: "fire_rocket", animation: "shoot", projectile: Rocket, windup: 0.4),
        (ability: "flamethrower", animation: "shoot", projectile: None, windup: 0.3),
        (ability: "jump", projectile: None),
        (ability: "particle_grenade", animation: "throw", projectile: Arc, windup: 0.3),
        (ability: "incendiary_grenade", animation: "throw", projectile: Arc, windup: 0.3),
    ],

    items: [
        (
            id: "rocket_launcher",
            name: "Rocket Launcher",
            description: "Grants Fire Rocket (one rocket per launcher).",
            slot: Utility,
            abilities: ["fire_rocket"],
            charges: Some(1),
            classes: ["heavy", "grenadier"],
        ),
        (
            id: "flamethrower_pack",
            name: "Flamethrower",
            description: "Grants Flamethrower (two tanks of fuel).",
            slot: Utility,
            abilities: ["flamethrower"],
            charges: Some(2),
            classes: ["heavy", "assault"],
        ),
        (
            id: "jump_pack",
            name: "Jump Pack",
            description: "Grants Jump: a straight-line leap of up to 2 moves that clears walls.",
            slot: Utility,
            abilities: ["jump"],
        ),
        (
            id: "particle",
            name: "Particle Grenade",
            description: "Grants Particle Grenade: short throw, goes off two turns later in a 5x5 square for 5 damage.",
            slot: Utility,
            abilities: ["particle_grenade"],
            charges: Some(1),
        ),
        (
            id: "incendiary",
            name: "Incendiary Grenade",
            description: "Grants Incendiary Grenade (one throw per grenade).",
            slot: Utility,
            abilities: ["incendiary_grenade"],
            charges: Some(1),
        ),
    ],

    classes: [
        (
            id: "heavy",
            name: "Heavy Gunner",
            stats: (max_hp: 12, mobility: 10, aim: 62, defense: 0, sight: 13.0, bravery: 60),
            weapon: "minigun",
            abilities: ["shoot", "suppress", "overwatch", "hunker", "reload"],
            model: "soldier",
            loadout: "heavy_std",
        ),
    ],

    loadouts: [
        (
            id: "heavy_std",
            name: "Heavy Gunner",
            description: "Minigun and a rocket launcher.",
            classes: ["heavy"],
            gear: (weapon: Some("minigun"), items: ["rocket_launcher"]),
        ),
        (
            id: "heavy_cannon",
            name: "Heavy: Autocannon",
            description: "Autocannon and two rocket launchers.",
            classes: ["heavy"],
            gear: (weapon: Some("autocannon"), items: ["rocket_launcher", "rocket_launcher"]),
        ),
        (
            id: "heavy_flame",
            name: "Heavy: Pyro",
            description: "Minigun, a flamethrower and an incendiary grenade.",
