            gear: (weapon: Some("minigun"), items: ["flamethrower_pack", "incendiary"]),
        ),
        (
            id: "heavy_inferno",
            name: "Heavy: Inferno",
            description: "Flamethrower as the main weapon, and an incendiary grenade.",
            classes: ["heavy"],
            gear: (weapon: Some("flamer"), items: ["incendiary"]),
        ),
        (
            id: "laser_trooper",
            name: "Laser Trooper",
            description: "Laser rifle for any soldier.",
            gear: (weapon: Some("laser_rifle")),
        ),
    ],
)
