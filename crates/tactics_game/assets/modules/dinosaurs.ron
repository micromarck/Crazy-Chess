// Dinosaurs: big beasts that take several tiles (the class `size`), written
// as a data module. Each footprint is size x size tiles; the beast blocks
// all of them, needs room for all of them to move, can be shot and blasted
// on any of them and bites anything next to any of them.
//
//   * Raptor   (1 tile)  - fast pack hunters, slashing claws. Packs screech
//                          when they spot you.
//   * Hornback (2x2)     - an armoured three-horned grazer: tough frill
//                          (defence), a goring charge; hurt, it gets angry
//                          and faster.
//   * Tyrant   (3x3)     - the king: huge bite, 30 HP. Its roar when it
//                          first sees the squad shakes everyone near.
//
// All of them hunt like a horde (close in and strike) and feel no fear.
// Squad "dinos" is a ready-made pack; see the Lost Valley mission.
//
// Units: metres, Y up, models face -Z. Rotations in degrees (X, Y, Z);
// +X pitches a bone forward/down.
(
    info: (
        id: "dinosaurs",
        name: "Dinosaurs",
        version: "1.0",
        author: "Tactics",
        description: "Raptors, the armoured Hornback (2x2) and the Tyrant (3x3): big beasts that take several tiles.",
    ),

    weapons: [
        // Natural weapons (nothing held). The attacks set their own damage.
        (id: "dino_jaws", name: "Jaws", damage_min: 2, damage_max: 3, optimal_range: 1.0, max_range: 1.5, clip_size: 0, magazines: 0, look: None),
    ],

    abilities: [
        (
            id: "slash",
            name: "Slash",
            description: "Sickle claws: 2-3 damage to an adjacent enemy.",
            cost: EndsTurn,
            targeting: Enemy,
            range: Fixed(1.5),
            effect: Attack(
                base_accuracy: 80,
                half_cover_penalty: 10,
                full_cover_penalty: 20,
                range_falloff: false,
                flank_crit_bonus: 20,
                damage: Fixed(min: 2, max: 3),
                melee: true,
            ),
        ),
        (
            id: "gore",
            name: "Gore",
            description: "Horns first: 3-5 damage to an adjacent enemy, cover doesn't help.",
            cost: EndsTurn,
            targeting: Enemy,
            range: Fixed(1.5),
            effect: Attack(
                base_accuracy: 75,
                half_cover_penalty: 0,
                full_cover_penalty: 0,
                range_falloff: false,
                flank_crit_bonus: 0,
                damage: Fixed(min: 3, max: 5),
                melee: true,
            ),
        ),
        (
            id: "chomp",
            name: "Chomp",
            description: "A bite that can take a soldier in one: 5-8 damage to an adjacent enemy.",
            cost: EndsTurn,
            targeting: Enemy,
            range: Fixed(1.5),
            effect: Attack(
                base_accuracy: 70,
                half_cover_penalty: 0,
                full_cover_penalty: 10,
                range_falloff: false,
                flank_crit_bonus: 0,
                crit_bonus: 15,
                damage: Fixed(min: 5, max: 8),
                melee: true,
            ),
        ),
    ],

    presentations: [
        (ability: "slash", animation: "bite", projectile: None, windup: 0.25),
        (ability: "gore", animation: "bite", projectile: None, windup: 0.3),
        (ability: "chomp", animation: "bite", projectile: None, windup: 0.4),
    ],

    classes: [
        (
            id: "dino_raptor",
            name: "Raptor",
            stats: (max_hp: 5, mobility: 18, aim: 70, defense: 10, sight: 14.0, bravery: 100),
            weapon: "dino_jaws",
            abilities: ["slash"],
            model: "dino_raptor",
            fearless: true,
            horde: true,
            hearing: 12.0,
            body: (height: 1.1),
            hooks: [
                (on: "spotted", once: true, code: r#"
                    say(unit, "SKREEEE!");
                    // The pack answers: every raptor nearby wakes.
                    for id in units("enemy") {
                        if unit_class(id) == "dino_raptor" && distance(unit, id) <= 10.0 { wake(id); }
                    }
                "#),
            ],
        ),
        (
            id: "dino_hornback",
            name: "Hornback",
            size: 2,
            stats: (max_hp: 18, mobility: 10, aim: 65, defense: 20, sight: 10.0, bravery: 100),
            weapon: "dino_jaws",
            abilities: ["gore"],
            model: "dino_hornback",
            fearless: true,
            horde: true,
            hearing: 8.0,
            no_half_cover: true,
            body: (height: 1.7),
            hooks: [
                (on: "damaged", once: true, code: r#"
                    if unit_alive(unit) {
                        say(unit, "SNORT!");
                        add_stat(unit, "mobility", 2);
                        wake(unit);
                    }
                "#),
            ],
        ),
        (
            id: "dino_tyrant",
            name: "Tyrant",
            size: 3,
            stats: (max_hp: 30, mobility: 12, aim: 70, defense: 5, sight: 16.0, bravery: 100),
            weapon: "dino_jaws",
            abilities: ["chomp"],
            model: "dino_tyrant",
            fearless: true,
            horde: true,
            hearing: 18.0,
            no_half_cover: true,
            body: (height: 3.2),
            hooks: [
                (on: "spotted", once: true, code: r#"
                    say(unit, "ROOOAAARRR!");
                    message("The ground shakes. Something enormous is coming.");
                    for id in units("player") {
                        if distance(unit, id) <= 14.0 { add_fear(id, 25); }
                    }
                "#),
            ],
        ),
    ],

    squads: [
        (
            id: "dinos",
            members: [
                (class: "dino_raptor", name: "Raptor 1"),
                (class: "dino_raptor", name: "Raptor 2"),
                (class: "dino_raptor", name: "Raptor 3"),
                (class: "dino_hornback", name: "Hornback"),
                (class: "dino_tyrant", name: "Tyrant"),
            ],
        ),
    ],

