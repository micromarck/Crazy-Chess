// Symbiotes: an alien growth that takes over bodies and minds.
//
//   * Crawler   (1 tile)  - fast little things that skitter out of the vines.
//   * Host      (1 tile)  - what's left of the crew. Bursts into vines when it dies.
//   * Puppeteer (1 tile)  - a floating mind: takes a soldier's mind (2 turns).
//   * Amalgam   (2x2)     - bodies fused into one heaving mass.
//   * The Choir (2x2)     - the heart of it all: never moves, grows vines,
//                           sings in your head and takes minds for 3 turns.
//
// All of them: fearless, FLAMMABLE (double damage from fire and flames),
// at home in their vines (they heal on them), and they build RAGE - every
// hit and every kindred death nearby - until they're enraged (+damage,
// +movement). Seeing them wears soldiers' sanity down (see the core's
// symbiote mechanics: insanity, mind control, vines).
(
    info: (
        id: "symbiotes",
        name: "Symbiotes",
        version: "1.0",
        author: "Tactics",
        description: "Crawlers, infected Hosts, mind-controlling Puppeteers, the 2x2 Amalgam and the Choir: a flammable alien growth with rage, vines and mind control.",
    ),

    weapons: [
        (id: "symb_tendrils", name: "Tendrils", damage_min: 1, damage_max: 2, optimal_range: 1.0, max_range: 1.5, clip_size: 0, magazines: 0, look: None),
        (
            id: "psi_bolt",
            name: "Psionic Bolt",
            damage_min: 1,
            damage_max: 2,
            crit_chance: 5,
            optimal_range: 6.0,
            max_range: 12.0,
            burst: 1,
            spread: 0.2,
            clip_size: 99,
            magazines: 9,
            look: Laser,
        ),
    ],

    abilities: [
        (
            id: "lash",
            name: "Lash",
            description: "Barbed tendrils: 1-3 damage to an adjacent enemy.",
            cost: EndsTurn,
            targeting: Enemy,
            range: Fixed(1.5),
            effect: Attack(
                base_accuracy: 80,
                half_cover_penalty: 10,
                full_cover_penalty: 20,
                range_falloff: false,
                flank_crit_bonus: 20,
                damage: Fixed(min: 1, max: 3),
                melee: true,
            ),
        ),
        (
            id: "maul",
            name: "Maul",
            description: "Grab and tear: 2-4 damage to an adjacent enemy.",
            cost: EndsTurn,
            targeting: Enemy,
            range: Fixed(1.5),
            effect: Attack(
                base_accuracy: 75,
                half_cover_penalty: 10,
                full_cover_penalty: 20,
                range_falloff: false,
                flank_crit_bonus: 20,
                damage: Fixed(min: 2, max: 4),
                melee: true,
            ),
        ),
        (
            id: "engulf",
            name: "Engulf",
            description: "Smother an adjacent enemy in flesh: 4-6 damage, cover doesn't help.",
            cost: EndsTurn,
            targeting: Enemy,
            range: Fixed(1.5),
            effect: Attack(
                base_accuracy: 75,
                half_cover_penalty: 0,
                full_cover_penalty: 0,
                range_falloff: false,
                flank_crit_bonus: 0,
                damage: Fixed(min: 4, max: 6),
                melee: true,
            ),
        ),
        (
            id: "dominate",
            name: "Dominate",
            description: "Take a soldier's mind: they fight for the symbiotes for 2 turns (+15 insanity). Not machines. 3 turn cooldown.",
            cost: EndsTurn,
            cooldown: 3,
            targeting: Enemy,
            range: Fixed(10.0),
            requires_los: true,
            effect: MindControl(turns: 2, insanity: 15),
        ),
        (
            id: "choir_call",
            name: "Call of the Choir",
            description: "The Choir takes a mind for 3 turns (+20 insanity). 2 turn cooldown.",
            cost: EndsTurn,
            cooldown: 2,
            targeting: Enemy,
            range: Fixed(14.0),
            requires_los: true,
            effect: MindControl(turns: 3, insanity: 20),
        ),
    ],

    presentations: [
        (ability: "lash", animation: "bite", projectile: None, windup: 0.25),
        (ability: "maul", animation: "bite", projectile: None, windup: 0.3),
        (ability: "engulf", animation: "bite", projectile: None, windup: 0.4),
        (ability: "dominate", animation: "cast", projectile: Beam, windup: 0.5),
        (ability: "choir_call", animation: "cast", projectile: Beam, windup: 0.6),
    ],

    classes: [
        (
            id: "symb_crawler",
            name: "Crawler",
            stats: (max_hp: 3, mobility: 16, aim: 70, defense: 10, sight: 12.0, bravery: 100),
            weapon: "symb_tendrils",
            abilities: ["lash"],
            model: "symb_crawler",
            fearless: true,
            horde: true,
            hearing: 12.0,
            flammable: true,
            vine_kin: true,
            rage: (per_hit: 40, per_ally_death: 25, decay: 15, threshold: 50, damage: 1, mobility: 4),
            body: (height: 0.5),
            hooks: [
                (on: "spotted", once: true, code: r#"
                    for id in units("player") { if distance(unit, id) <= 8.0 { add_insanity(id, 2); } }
                "#),
            ],
        ),
        (
            id: "symb_host",
            name: "Host",
            stats: (max_hp: 7, mobility: 10, aim: 65, defense: 0, sight: 11.0, bravery: 100),
            weapon: "symb_tendrils",
            abilities: ["maul"],
            model: "symb_host",
            fearless: true,
            horde: true,
            hearing: 12.0,
            flammable: true,
            vine_kin: true,
            rage: (per_hit: 30, per_ally_death: 25, decay: 15, threshold: 50, damage: 2, mobility: 4),
            hooks: [
                (on: "spotted", once: true, code: r#"
                    say(unit, "...help... me...");
                    for id in units("player") { if distance(unit, id) <= 8.0 { add_insanity(id, 4); } }
                "#),
                // It bursts: the growth inside spills out.
                (on: "death", code: r#"plant_vines(x, y, 1.5);"#),
            ],
        ),
        (
            id: "symb_puppeteer",
            name: "Puppeteer",
            stats: (max_hp: 6, mobility: 10, aim: 62, defense: 15, sight: 14.0, bravery: 100),
            weapon: "psi_bolt",
            abilities: ["dominate", "shoot"],
            model: "symb_puppeteer",
            fearless: true,
            hearing: 14.0,
            flammable: true,
            vine_kin: true,
            rage: (per_hit: 35, per_ally_death: 20, decay: 15, threshold: 50, damage: 1, mobility: 2),
            body: (hover: 0.5, height: 0.8, muzzle: Some(1.0)),
            hooks: [
                (on: "spotted", once: true, code: r#"
                    say(unit, "We see you.");
                    message("A Puppeteer. You can feel it, cold fingers inside your head.");
                    for id in units("player") { if distance(unit, id) <= 12.0 { add_insanity(id, 8); } }
                "#),
            ],
        ),
        (
            id: "symb_amalgam",
            name: "Amalgam",
            size: 2,
            stats: (max_hp: 22, mobility: 10, aim: 70, defense: 10, sight: 11.0, bravery: 100),
            weapon: "symb_tendrils",
            abilities: ["engulf"],
            model: "symb_amalgam",
            fearless: true,
            horde: true,
            hearing: 14.0,
            flammable: true,
            vine_kin: true,
            no_half_cover: true,
            rage: (per_hit: 20, per_ally_death: 25, decay: 10, threshold: 50, damage: 3, mobility: 4),
            body: (height: 2.4),
            hooks: [
                (on: "spotted", once: true, code: r#"
                    say(unit, "*wet, many-voiced moan*");
                    message("Bodies. Dozens of them, fused into one thing that walks.");
                    for id in units("player") { if distance(unit, id) <= 10.0 { add_insanity(id, 10); } }
                "#),
                (on: "death", code: r#"plant_vines(x, y, 2.5);"#),
            ],
        ),
        (
            id: "symb_choir",
            name: "The Choir",
            size: 2,
            stats: (max_hp: 40, mobility: 0, aim: 70, defense: 5, sight: 16.0, bravery: 100),
            weapon: "psi_bolt",
            abilities: ["choir_call", "shoot"],
            model: "symb_choir",
            fearless: true,
            hearing: 20.0,
            flammable: true,
            vine_kin: true,
            no_half_cover: true,
            rage: (per_hit: 15, per_ally_death: 10, decay: 10, threshold: 50, damage: 2, mobility: 0),
            body: (height: 2.6, muzzle: Some(2.0)),
            hooks: [
                (on: "spotted", once: true, code: r#"
                    message("THE CHOIR: *a hundred stolen voices, singing as one, inside your skull*");
                    for id in units("player") { add_insanity(id, 10); }
                "#),
                // Every one of its turns: it grows, it sings, it breeds.
                // (Only once it's awake: asleep, it just dreams.)
                (on: "turn_start", code: r#"
                    if !unit_dormant(unit) {
                        plant_vines(x, y, 2.5);
                        for id in units("player") { if distance(unit, id) <= 16.0 { add_insanity(id, 3); } }
                        if round % 2 == 0 && alive_count("enemy") < 30 { spawn_unit("enemy", "symb_crawler", "Crawler", x + 2, y); }
                    }
                "#),
            ],
        ),
    ],

    squads: [
        (
            id: "symbiotes",
            members: [
                (class: "symb_crawler", name: "Crawler 1"),
                (class: "symb_crawler", name: "Crawler 2"),
                (class: "symb_host", name: "Host"),
                (class: "symb_puppeteer", name: "Puppeteer"),
                (class: "symb_amalgam", name: "Amalgam"),
            ],
        ),
    ],

