                "hand_l":      [(0.0, (10.0, 0.0, 0.0))],
                "hand_r":      [(0.0, (10.0, 0.0, 0.0))],
                "thigh_l":     [(0.0, (8.0, 0.0, -4.0))],
                "thigh_r":     [(0.0, (-4.0, 0.0, 5.0))],
                "shin_l":      [(0.0, (-14.0, 0.0, 0.0))],
                "shin_r":      [(0.0, (-6.0, 0.0, 0.0))],
            },
        ),
        // The shamble: a long stride on the left, the right foot dragged
