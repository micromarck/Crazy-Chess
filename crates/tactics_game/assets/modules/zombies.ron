                "jaw":         [(0.0, (25.0, 0.0, 0.0)), (0.3, (55.0, 0.0, 0.0)), (0.45, (0.0, 0.0, 0.0)), (0.55, (40.0, 0.0, 0.0)), (0.8, (25.0, 0.0, 0.0))],
