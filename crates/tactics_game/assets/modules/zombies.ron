                "spine":       [(0.0, (14.0, 6.0, 4.0)), (0.6, (14.0, -6.0, -4.0)), (1.2, (14.0, 6.0, 4.0))],
                "chest":       [(0.0, (20.0, 0.0, 0.0)), (0.3, (26.0, 0.0, 0.0)), (0.6, (20.0, 0.0, 0.0)), (0.9, (26.0, 0.0, 0.0)), (1.2, (20.0, 0.0, 0.0))],
                "head":        [(0.0, (-18.0, 0.0, 18.0)), (0.6, (-12.0, 0.0, 26.0)), (1.2, (-18.0, 0.0, 18.0))],
                "jaw":         [(0.0, (25.0, 0.0, 0.0)), (0.6, (35.0, 0.0, 0.0)), (1.2, (25.0, 0.0, 0.0))],
                "thigh_l":     [(0.0, (35.0, 0.0, -3.0)), (0.3, (5.0, 0.0, -3.0)), (0.6, (-25.0, 0.0, -3.0)), (0.9, (10.0, 0.0, -3.0)), (1.2, (35.0, 0.0, -3.0))],
                "shin_l":      [(0.0, (-8.0, 0.0, 0.0)), (0.3, (-20.0, 0.0, 0.0)), (0.6, (-25.0, 0.0, 0.0)), (0.9, (-70.0, 0.0, 0.0)), (1.2, (-8.0, 0.0, 0.0))],
                "foot_l":      [(0.0, (10.0, 0.0, 0.0)), (0.6, (-20.0, 0.0, 0.0)), (1.2, (10.0, 0.0, 0.0))],
                // The dragged leg barely lifts.
                "thigh_r":     [(0.0, (-20.0, 0.0, 6.0)), (0.6, (12.0, 0.0, 6.0)), (1.2, (-20.0, 0.0, 6.0))],
                "shin_r":      [(0.0, (-12.0, 0.0, 0.0)), (0.6, (-18.0, 0.0, 0.0)), (1.2, (-12.0, 0.0, 0.0))],
                "foot_r":      [(0.0, (-25.0, 0.0, 10.0)), (0.6, (0.0, 0.0, 10.0)), (1.2, (-25.0, 0.0, 10.0))],
                "upper_arm_l": [(0.0, (75.0, 0.0, -8.0)), (0.3, (68.0, 0.0, -8.0)), (0.6, (80.0, 0.0, -4.0)), (0.9, (70.0, 0.0, -8.0)), (1.2, (75.0, 0.0, -8.0))],
                "upper_arm_r": [(0.0, (65.0, 0.0, 8.0)), (0.3, (78.0, 0.0, 6.0)), (0.6, (68.0, 0.0, 10.0)), (0.9, (80.0, 0.0, 6.0)), (1.2, (65.0, 0.0, 8.0))],
                "forearm_l":   [(0.0, (15.0, 0.0, 0.0))],
                "forearm_r":   [(0.0, (22.0, 0.0, 0.0))],
            },
        ),
        // The bite: rear back, lunge with both arms grabbing, snap the jaw.
        (
            skeleton: "zombie",
            slot: "bite",
            duration: 0.8,
            translations: {
                "hips": [(0.0, (0.0, 0.0, 0.0)), (0.2, (0.0, 0.0, 0.08)), (0.4, (0.0, -0.06, -0.22)), (0.8, (0.0, 0.0, 0.0))],
            },
            rotations: {
                "chest":       [(0.0, (20.0, 0.0, 0.0)), (0.2, (5.0, 0.0, 0.0)), (0.4, (45.0, 0.0, 0.0)), (0.6, (40.0, 0.0, 0.0)), (0.8, (20.0, 0.0, 0.0))],
